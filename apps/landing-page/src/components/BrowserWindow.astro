---
interface Props {
  title?: string;
  url?: string;
  dots?: "mono" | "traffic";
  class?: string;
  contentClass?: string;
}

const {
  title,
  url,
  dots = "mono",
  class: className = "",
  contentClass = "",
} = Astro.props;

const dotColors =
  dots === "traffic"
    ? ["bg-[#ff5f57]", "bg-[#febc2e]", "bg-[#28c840]"]
    : ["bg-base-300", "bg-base-300", "bg-base-300"];
---

<div
  class={`overflow-hidden rounded-md border border-border-soft bg-bg-elev ${className}`}
>
  <div
    class="flex items-center gap-3 border-b border-border-soft bg-bg-card px-4 py-3"
  >
    <div class="flex items-center gap-2 opacity-40">
      {dotColors.map((c) => <span class={`size-3 rounded-full ${c}`} />)}
    </div>

    {
      url && (
        <div class="ml-1 flex h-7 flex-1 items-center rounded-md bg-base-100 px-3 text-xs text-fg-faint">
          {url}
        </div>
      )
    }

    {
      title && !url && (
        <span class="text-xs font-medium text-fg-faint">{title}</span>
      )
    }
  </div>

  <div
    class={`flex min-h-48 items-center justify-center p-2 text-sm text-fg-muted ${contentClass}`}
  >
    <slot>Hello!</slot>
  </div>
</div>
