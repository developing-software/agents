---
import { tv, type VariantProps } from "tailwind-variants";
import type { HTMLAttributes } from "astro/types";

export const buttonVariants = tv({
  base: "group/button inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-sm border font-semibold outline-none transition-all duration-300 select-none focus-visible:ring-2 focus-visible:ring-border-glow active:translate-y-px disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-5",
  variants: {
    variant: {
      default:
        "border-base-200 bg-bg-card text-fg hover:border-base-300 hover:bg-base-200/50",
      primary: "border-transparent bg-acc text-acc-foreground hover:bg-acc/70",
      secondary: "border-transparent bg-base-200 text-fg hover:bg-base-300",
      outline: "border-border-strong bg-transparent text-fg hover:bg-base-100",
      ghost: "border-transparent text-fg-muted hover:bg-base-100 hover:text-fg",
      link: "border-transparent text-acc underline-offset-4 hover:underline",
    },
    size: {
      xs: "h-7 px-3 text-xs",
      sm: "h-9 px-4 text-sm",
      md: "h-10.5 px-5 text-[14px]",
      lg: "h-12 px-6 text-base",
      icon: "size-10.5",
    },
  },
  compoundVariants: [{ variant: "link", class: "h-auto px-0" }],
  defaultVariants: {
    variant: "default",
    size: "md",
  },
});

export type ButtonVariant = VariantProps<typeof buttonVariants>["variant"];
export type ButtonSize = VariantProps<typeof buttonVariants>["size"];

interface Props extends HTMLAttributes<"button"> {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  text?: string;
  icon?: any;
}

const {
  variant = "default",
  size = "md",
  href,
  text,
  icon: Icon,
  class: className,
  type = "button",
  ...rest
} = Astro.props;

const classes = buttonVariants({ variant, size, class: className });
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot>{text}</slot>
      {Icon && <Icon class="size-5" />}
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot>{text}</slot>
      {Icon && <Icon class="size-5" />}
    </button>
  )
}
