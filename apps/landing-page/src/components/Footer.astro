  },
  {
    label: "X",
    href: "#",
    path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z",
  },
  {
    label: "Discord",
    href: "#",
    path: "M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.371-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.245.198.372.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028ZM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.956 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.946 2.418-2.157 2.418Z",
  },
];

const year = new Date().getFullYear();
---

<footer class="relative mt-32 overflow-hidden border-t border-border-soft">
  <div class="relative z-10 pt-16">
    <!-- top: brand + navigation -->
    <div class="grid gap-12 lg:grid-cols-[1.5fr_2fr]">
      <!-- brand -->
      <div class="max-w-sm">
        <a href="/" class="inline-flex items-center gap-2">
          <span class="text-2xl font-semibold tracking-[-0.01em] text-fg"
            >DevAgents</span
          >
        </a>
        <p class="mt-4 text-[15px] leading-[1.55] text-fg-muted">
          Many models enter, one PR wins. Connect your repo and review
          perfection instead of writing boilerplate.
        </p>

        <div class="mt-6">
          <Button
            text="Connect Repository"
            variant="primary"
            size="sm"
            href="#"
          />
        </div>

        <div class="mt-7 flex items-center gap-2.5">
          {
            socials.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                class="group grid size-9 place-items-center rounded-md border border-border-soft text-fg-faint transition-all duration-200 hover:-translate-y-0.5 hover:border-border-strong hover:bg-base-100 hover:text-fg"
              >
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={s.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- navigation columns -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {
          columns.map((col) => (
            <nav class="flex flex-col">
              <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-fg-faint">
                {col.title}
              </span>
              <ul class="mt-4 flex flex-col gap-3">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="group inline-flex items-center gap-1.5 text-[14px] text-fg-muted transition-colors hover:text-fg"
                    >
                      <span class="h-px w-0 bg-acc transition-all duration-300 group-hover:w-3" />
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <!-- bottom bar -->
    <div
      class="mt-14 flex flex-col-reverse items-start justify-between gap-6 border-t border-border-soft py-7 sm:flex-row sm:items-center"
    >
      <p class="font-mono text-[11px] tracking-wide text-fg-faint">
        © {year} DevAgents · All rights reserved.
      </p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        {
          legal.map((link) => (
            <a
              href={link.href}
              class="text-[13px] text-fg-muted transition-colors hover:text-fg"
            >
              {link.label}
            </a>
          ))
        }
        <span
          class="inline-flex items-center gap-2 rounded-full border border-border-soft px-3 py-1.5"
        >
          <span class="relative flex size-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-acc-deep opacity-60"
            ></span>
            <span class="relative inline-flex size-2 rounded-full bg-acc-deep"
            ></span>
          </span>
          <span
            class="font-mono text-[10px] uppercase tracking-[0.1em] text-fg-muted"
            >All systems operational</span
          >
        </span>
      </div>
    </div>
  </div>

  <!-- oversized wordmark watermark -->
  <div aria-hidden="true" class="pointer-events-none relative select-none">
    <span
      class="-mb-[2.5vw] block bg-linear-to-b from-fg/[0.08] to-transparent bg-clip-text text-center text-[20vw] font-semibold leading-[0.8] tracking-[-0.05em] text-transparent"
    >
      DevAgents
    </span>
  </div>
</footer>
