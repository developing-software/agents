---
import Button from "./Button.astro";

const links = [
  { name: "Link 1", href: "#" },
  { name: "Link 2", href: "#" },
];
---

<nav class="mx-auto container flex items-center justify-between py-4">
  <div>
    <a href="/" class="text-2xl font-bold">DevAgents</a>
  </div>

  <div class="space-x-8">
    {links.map((link) => <a href={link.href}>{link.name}</a>)}
  </div>

  <div class="space-x-4">
    <a href="">Sign in</a>
    <Button text="Connect Repository" variant="primary" />
  </div>
</nav>
