---
/* channels drift in from the left, models from the right — only where there is room beside the headline */
const chips = [
  { src: "/brands/whatsapp-svgrepo-com.svg", img: "size-6 rounded-[6px]", style: "left:5%;top:16%;rotate:-8deg" },
  { src: "/brands/SLA-Slack-icon-RGB.svg", img: "size-5", style: "left:13%;top:48%;rotate:6deg" },
  { src: "/brands/GitHub_Invertocat_Black.svg", img: "size-5", style: "left:6%;top:76%;rotate:-4deg" },
  { src: "/ai/claude.svg", img: "size-5", style: "right:5%;top:18%;rotate:7deg" },
  { src: "/ai/openai.svg", img: "size-5", style: "right:13%;top:50%;rotate:-6deg" },
  { src: "/ai/gemini.svg", img: "size-5", style: "right:6%;top:76%;rotate:5deg" },
];
---

<section class="section">
  <div class="shell">
    <div
      data-reveal
      class="relative overflow-hidden rounded-frame border border-border-soft bg-bg-sunk p-3 sm:p-4"
    >
      <div
        class="relative overflow-hidden rounded-card bg-bg-elev px-6 py-20 text-center sm:px-12 sm:py-24"
      >
        <div aria-hidden="true" class="pointer-events-none absolute inset-0">
          <div
            class="absolute left-1/2 -top-40 h-96 w-[48rem] -translate-x-1/2 rounded-[50%] opacity-80 blur-[80px]"
            style="background:radial-gradient(closest-side,rgba(145,120,211,0.16),rgba(145,120,211,0.05) 60%,transparent 80%)"
          >
          </div>
          <div
            class="dotgrid absolute inset-0 opacity-60"
            style="mask-image:radial-gradient(70% 80% at 50% 45%,#000,transparent 85%);-webkit-mask-image:radial-gradient(70% 80% at 50% 45%,#000,transparent 85%)"
          >
          </div>

          {
            chips.map((c, i) => (
              <span
                class="absolute hidden size-12 animate-[chip-float_6s_ease-in-out_infinite] place-items-center rounded-panel border border-border-soft bg-bg-elev xl:grid"
                style={`${c.style};animation-duration:${(5 + (i % 3) * 0.9).toFixed(1)}s;animation-delay:-${(i * 0.8).toFixed(1)}s`}
              >
                <img src={c.src} alt="" class={c.img} />
              </span>
            ))
          }
        </div>

        <div class="relative">
          <h2
            data-reveal
            class="mx-auto max-w-3xl text-balance text-[clamp(2rem,4.2vw,3.35rem)] font-medium leading-[1.05] tracking-[-0.035em] text-fg"
          >
            Shipping software wasn't built for
            <span class="italic font-normal text-acc"
              >one engineer and five clients.</span
            >
          </h2>

          <p
            data-reveal
            class="mt-6 text-[clamp(1.6rem,3vw,2.2rem)] font-medium leading-none tracking-[-0.035em] text-fg"
          >
            DevAgents was.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
