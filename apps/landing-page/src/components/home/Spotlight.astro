---
---

<section class="relative overflow-hidden">
  <div class="shell py-14 sm:py-16">
    <div
      class="grain relative overflow-hidden rounded-3xl px-6 py-20 text-center sm:px-12 sm:py-28"
      style="background:#0a0c10"
    >
      <!-- grid -->
      <div
        aria-hidden="true"
        class="absolute inset-0 opacity-[0.55]"
        style="background-image:linear-gradient(rgba(255,255,255,0.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.06) 1px,transparent 1px);background-size:44px 44px;mask-image:radial-gradient(75% 75% at 50% 40%,#000,transparent 85%);-webkit-mask-image:radial-gradient(75% 75% at 50% 40%,#000,transparent 85%)"
      >
      </div>

      <!-- faceted shapes, top-left -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -left-16 -top-16 size-64 -rotate-[18deg] opacity-90 sm:-left-10 sm:-top-14"
      >
        <div
          class="absolute inset-0"
          style="clip-path:polygon(50% 0%,100% 38%,62% 100%,38% 62%);background:linear-gradient(135deg,#ff9d6c 0%,#ef6f8e 45%,#8f7bf0 100%)"
        >
        </div>
        <div
          class="absolute inset-0 translate-x-6 translate-y-3 opacity-80"
          style="clip-path:polygon(50% 0%,100% 38%,62% 100%,38% 62%);background:linear-gradient(135deg,#8f7bf0 0%,#5aa8f5 60%,#52d6c8 100%)"
        >
        </div>
      </div>

      <!-- faceted shapes, bottom-right -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-20 -right-14 size-64 rotate-[24deg] opacity-90 sm:-bottom-16 sm:-right-10"
      >
        <div
          class="absolute inset-0"
          style="clip-path:polygon(50% 0%,100% 38%,62% 100%,38% 62%);background:linear-gradient(135deg,#52d6c8 0%,#5aa8f5 55%,#8f7bf0 100%)"
        >
        </div>
        <div
          class="absolute inset-0 -translate-x-6 -translate-y-3 opacity-80"
          style="clip-path:polygon(50% 0%,100% 38%,62% 100%,38% 62%);background:linear-gradient(135deg,#8f7bf0 0%,#ef6f8e 55%,#ff9d6c 100%)"
        >
        </div>
      </div>

      <div class="relative">
        <h2
          data-reveal
          class="mx-auto max-w-3xl text-balance text-[clamp(1.9rem,4.4vw,3.4rem)] font-medium leading-[1.08] tracking-[-0.03em] text-white"
        >
          Shipping software wasn't built for
          <span
            style="background:linear-gradient(90deg,#7fb8ff 0%,#c48cf0 50%,#ff9d6c 100%);-webkit-background-clip:text;background-clip:text;color:transparent"
            >one engineer and five clients.</span
          >
        </h2>

        <p
          data-reveal
          style="--d:80ms"
          class="mt-3 text-[clamp(1.5rem,3vw,2.1rem)] italic font-normal leading-none text-white/85"
        >
          DevAgents was.
        </p>
      </div>
    </div>
  </div>
</section>
