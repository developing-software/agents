---
import SectionHead from "@components/SectionHead.astro";
import Icon from "@components/Icon.astro";

const logos = {
  github: { src: "/brands/GitHub_Invertocat_Black.svg", alt: "GitHub", imgClass: "size-6" },
  whatsapp: { src: "/brands/whatsapp-svgrepo-com.svg", alt: "WhatsApp", imgClass: "size-7 rounded-[7px]" },
  slack: { src: "/brands/SLA-Slack-icon-RGB.svg", alt: "Slack", imgClass: "size-6" },
  discord: { src: "/brands/Discord-Symbol-Blurple.svg", alt: "Discord", imgClass: "w-7" },
  telegram: { src: "/brands/telegram.svg", alt: "Telegram", imgClass: "size-7" },
  buzz: { src: "/brands/Buzz.svg", alt: "Buzz", imgClass: "w-7" },
};

const channels = [
  { ...logos.github, left: 6, top: 0, rotate: -9 },
  // { ...logos.whatsapp, left: 26, top: 6, rotate: 5 },
  { ...logos.buzz, left: 38, top: 1, rotate: -4 },
  { ...logos.discord, left: 54, top: 52, rotate: 8 },
  { ...logos.telegram, left: 74, top: 2, rotate: -6 },
  { ...logos.slack, left: 20, top: 52, rotate: 7 },
  // { ...logos.telegram, left: 34, top: 58, rotate: -5 },
  // { ...logos.github, left: 54, top: 50, rotate: 6 },
  { ...logos.whatsapp, left: 92, top: 56, rotate: -8 },
  // { ...logos.buzz, left: 94, top: 51, rotate: 4 },
];

const attempts = [
  { name: "claude-fable-5-1", logo: "/ai/claude.svg", pct: 72, state: "running" as const },
  { name: "gpt-6-astra", logo: "/ai/openai.svg", pct: 100, state: "passed" as const },
  { name: "gemini-3-8", logo: "/ai/gemini.svg", pct: 58, state: "failed" as const },
];

const checks = ["Tests", "Types", "Lint", "Preview"];

/* every visual sits in the same inset stage so the three cards read as a set */
const stage =
  "relative mt-auto h-72 overflow-hidden rounded-panel border border-border-soft bg-bg-sunk";
const texture = "dotgrid pointer-events-none absolute inset-0 opacity-60";
const fade =
  "mask-image:linear-gradient(to bottom,#000,transparent 85%);-webkit-mask-image:linear-gradient(to bottom,#000,transparent 85%)";
---

<section class="section">
  <div class="shell">
    <SectionHead
      eyebrow="One run"
      title="One request. Three things happen."
      accent="Each one makes the next better."
      sub="The message, the agents, and the pull request all come from the same run — nothing is retyped by hand between them."
    />

    <div
      data-reveal
      class="relative mt-head overflow-hidden rounded-frame border border-border-soft bg-bg-sunk p-3 sm:p-4"
    >
      <div
        aria-hidden="true"
        class="dotgrid pointer-events-none absolute inset-0 opacity-70"
        style="mask-image:radial-gradient(85% 85% at 50% 40%,#000,transparent 90%);-webkit-mask-image:radial-gradient(85% 85% at 50% 40%,#000,transparent 90%)"
      >
      </div>

      <div class="relative grid gap-3 lg:grid-cols-3">
        <!-- 1 · request -->
        <article class="flex flex-col rounded-card bg-bg-elev p-6 sm:p-7">
          <h3
            class="text-[19px] font-medium leading-snug tracking-[-0.015em] text-fg"
          >
            Your request, captured.
          </h3>
          <p class="mb-7 mt-3 text-[14px] leading-[1.6] text-fg-muted">
            Every channel your clients already use lands in the same place —
            scoped, flagged, and ready before a model touches code.
          </p>

          <div class={stage}>
            <div aria-hidden="true" class={texture} style={fade}></div>

            <div aria-hidden="true" class="absolute inset-x-5 top-5 h-32">
              {
                channels.map((c, i) => (
                  <span
                    class="absolute grid size-11 animate-[chip-float_6s_ease-in-out_infinite] -translate-x-1/2 place-items-center rounded-panel border border-border-soft bg-bg-elev"
                    style={`left:${c.left}%;top:${c.top}%;rotate:${c.rotate}deg;animation-duration:${(5 + (i % 3) * 0.9).toFixed(1)}s;animation-delay:-${(i * 0.7).toFixed(1)}s`}
                  >
                    <img src={c.src} alt="" class={c.imgClass} />
                  </span>
                ))
              }
            </div>

            <div
              class="absolute inset-x-4 -bottom-3 rounded-panel border border-border-soft bg-bg-elev px-4 pb-6 pt-4"
            >
              <div class="flex items-center gap-2">
                <img
                  src="/brands/whatsapp-svgrepo-com.svg"
                  alt=""
                  class="size-4 rounded-sm"
                />
                <span class="text-[12px] font-medium text-fg">Marina</span>
                <span class="text-[11px] text-fg-faint">via WhatsApp</span>
                <span
                  class="ml-auto font-mono text-[10.5px] tabular-nums text-fg-faint"
                  >23:14</span
                >
              </div>
              <p class="mt-2.5 text-balance text-[13.5px] leading-normal text-fg">
                “Can clients export invoices as a PDF?”
              </p>
              <div
                class="mt-3.5 flex items-center gap-2 border-t border-border-soft pt-3"
              >
                <span class="size-1.5 rounded-full bg-acc"></span>
                <span class="font-mono text-[10.5px] text-fg-muted"
                  >Scoped into SPEC-4821</span
                >
                <span class="ml-auto font-mono text-[10.5px] text-fg-faint"
                  >3 files</span
                >
              </div>
            </div>
          </div>
        </article>

        <!-- 2 · agents -->
        <article class="flex flex-col rounded-card bg-bg-elev p-6 sm:p-7">
          <h3
            class="text-[19px] font-medium leading-snug tracking-[-0.015em] text-fg"
          >
            Your agents, working on it.
          </h3>
          <p class="mb-7 mt-3 text-[14px] leading-[1.6] text-fg-muted">
            Any model, any framework. Each one reads the spec and writes back to
            the same branch history the others can see.
          </p>

          <div class={stage}>
            <div aria-hidden="true" class={texture} style={fade}></div>

            <div
              class="absolute inset-x-4 -bottom-px top-5 rounded-t-panel border border-b-0 border-border-soft bg-bg-elev"
            >
              <div
                class="flex items-center justify-between border-b border-border-soft px-4 py-3"
              >
                <span
                  class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-fg-faint"
                  >Run 4821</span
                >
                <span class="flex items-center gap-1.5 text-[11px] text-fg-muted">
                  <span class="size-1.5 animate-pulse rounded-full bg-acc"></span>
                  3 attempts live
                </span>
              </div>

              <ul class="divide-y divide-border-soft">
                {
                  attempts.map((a) => (
                    <li
                      class:list={[
                        "flex items-center gap-3 px-4 py-3",
                        a.state === "failed" && "opacity-55",
                      ]}
                    >
                      <span class="grid size-8 shrink-0 place-items-center rounded-lg border border-border-soft bg-bg">
                        <img src={a.logo} alt="" class="size-4" />
                      </span>
                      <div class="min-w-0 flex-1">
                        <div class="flex items-baseline justify-between gap-2">
                          <span class="truncate text-[12.5px] font-medium text-fg">
                            {a.name}
                          </span>
                          <span
                            class:list={[
                              "shrink-0 font-mono text-[10.5px] tabular-nums",
                              a.state === "passed" && "text-ok",
                              a.state === "failed" && "text-err",
                              a.state === "running" && "text-fg-faint",
                            ]}
                          >
                            {a.state === "running"
                              ? `${a.pct}%`
                              : a.state === "passed"
                                ? "Passed"
                                : "CI failed"}
                          </span>
                        </div>
                        <div class="mt-2 h-1 overflow-hidden rounded-full bg-base-100">
                          <div
                            class:list={[
                              "relative h-full overflow-hidden rounded-full",
                              a.state === "passed" && "bg-ok",
                              a.state === "failed" && "bg-err/50",
                              a.state === "running" && "bg-acc",
                            ]}
                            style={`width:${a.pct}%`}
                          >
                            {a.state === "running" && (
                              <span
                                class="absolute inset-y-0 left-0 w-1/2 animate-[sweep_2.2s_ease-in-out_infinite]"
                                style="background:linear-gradient(to right,transparent,rgba(255,255,255,0.65),transparent)"
                              />
                            )}
                          </div>
                        </div>
                      </div>
                    </li>
                  ))
                }
              </ul>

              <div
                class="absolute inset-x-0 bottom-0 flex items-center gap-2 border-t border-border-soft px-4 py-3"
              >
                <Icon name="scale" class="size-3.5 text-acc" stroke={1.8} />
                <span class="font-mono text-[10.5px] text-fg-muted"
                  >Judge merges the 2 best attempts</span
                >
              </div>
            </div>
          </div>
        </article>

        <!-- 3 · pull request -->
        <article class="flex flex-col rounded-card bg-bg-elev p-6 sm:p-7">
          <h3
            class="text-[19px] font-medium leading-snug tracking-[-0.015em] text-fg"
          >
            Your pull request, shipped.
          </h3>
          <p class="mb-7 mt-3 text-[14px] leading-[1.6] text-fg-muted">
            The strongest parts of every surviving attempt are rewritten into
            one diff, gated behind your checks — merged once you approve it.
          </p>

          <div class={stage}>
            <div aria-hidden="true" class={texture} style={fade}></div>

            <!-- the attempts it was synthesised from, stacked behind -->
            <div
              aria-hidden="true"
              class="absolute inset-x-10 top-8 h-16 rounded-panel border border-border-soft bg-bg-elev"
            >
            </div>
            <div
              aria-hidden="true"
              class="absolute inset-x-7 top-12 h-16 rounded-panel border border-border-soft bg-bg-elev"
            >
            </div>

            <div
              class="absolute inset-x-4 -bottom-px top-16 rounded-t-panel border border-b-0 border-border-soft bg-bg-elev"
            >
              <div
                class="flex items-center gap-2.5 border-b border-border-soft px-4 py-3"
              >
                <span
                  class="grid size-6 shrink-0 place-items-center rounded-md bg-ok-wash text-ok"
                >
                  <Icon name="pr" class="size-3.5" stroke={1.8} />
                </span>
                <span class="min-w-0 flex-1 truncate text-[12.5px] font-medium text-fg">
                  Add invoice PDF download
                </span>
                <span class="shrink-0 font-mono text-[10.5px] text-fg-faint">#128</span>
              </div>

              <div class="px-4 py-3.5">
                <div class="flex items-center gap-2 font-mono text-[10.5px] tabular-nums">
                  <span class="text-ok">+148</span>
                  <span class="text-err">−12</span>
                  <span class="ml-1 flex gap-px">
                    <span class="size-1.5 rounded-[1px] bg-ok"></span>
                    <span class="size-1.5 rounded-[1px] bg-ok"></span>
                    <span class="size-1.5 rounded-[1px] bg-ok"></span>
                    <span class="size-1.5 rounded-[1px] bg-ok"></span>
                    <span class="size-1.5 rounded-[1px] bg-err"></span>
                  </span>
                  <span class="ml-auto text-fg-faint">12 files</span>
                </div>

                <div class="mt-3.5 grid grid-cols-2 gap-x-4 gap-y-2">
                  {
                    checks.map((c) => (
                      <span class="flex items-center gap-1.5 text-[11.5px] text-fg-muted">
                        <Icon name="check" class="size-3 text-ok" stroke={2.4} />
                        {c}
                      </span>
                    ))
                  }
                </div>
              </div>

              <div
                class="flex items-center border-t border-border-soft px-4 py-3"
              >
                <span
                  class="inline-flex items-center gap-1 rounded-full bg-ok-wash px-2 py-0.5 text-[11px] font-medium text-ok"
                >
                  <Icon name="check" class="size-2.5" stroke={2.6} /> Merged
                </span>
                <span class="ml-auto text-[11px] text-fg-faint">by you · 08:04</span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
