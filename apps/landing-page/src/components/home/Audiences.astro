---
import SectionHead from "@components/SectionHead.astro";
import WhatsAppChat from "@components/mock/WhatsAppChat.astro";
import Preview from "@components/mock/Preview.astro";

const stage =
  "relative mt-auto flex flex-1 items-center overflow-hidden rounded-panel border border-border-soft bg-bg-sunk p-4 sm:p-8";
const texture = "dotgrid pointer-events-none absolute inset-0 opacity-60";
const fade =
  "mask-image:radial-gradient(80% 80% at 50% 50%,#000,transparent 90%);-webkit-mask-image:radial-gradient(80% 80% at 50% 50%,#000,transparent 90%)";

const steps = [
  {
    label: "01 · Ask",
    title: "Describe it like you'd tell a friend.",
    body: "Clients write in the chat they already use. No tickets to file, no repository access, no pull requests to understand.",
    mock: "chat",
  },
  {
    label: "02 · Click",
    title: "Get a link you can click.",
    body: "The change goes live on its own preview, so the person who asked checks the real thing before you approve the merge.",
    mock: "preview",
  },
];
---

<section class="section">
  <div class="shell">
    <SectionHead
      title="It gives the client a way in"
      accent="without taking the keys."
      sub="Your clients don't need to know what a pull request is. They ask in plain words, and you keep the veto."
    />

    <div
      data-reveal
      class="relative mt-head overflow-hidden rounded-frame border border-border-soft bg-bg-sunk p-3 sm:p-4"
    >
      <div
        aria-hidden="true"
        class="dotgrid pointer-events-none absolute inset-0 opacity-70"
        style="mask-image:radial-gradient(85% 85% at 50% 40%,#000,transparent 90%);-webkit-mask-image:radial-gradient(85% 85% at 50% 40%,#000,transparent 90%)"
      >
      </div>

      <div class="relative grid gap-3 lg:grid-cols-2">
        {
          steps.map((s, i) => (
            <>
            {i === 1 && (
              /* stacked: sits in the gutter between the cards; side by side: centred on the frame */
              <span
                aria-hidden="true"
                class="hop relative z-10 mx-auto -my-6.5 grid size-10 rotate-90 place-items-center rounded-full bg-acc text-bg ring-4 ring-bg-sunk lg:absolute lg:left-1/2 lg:top-1/2 lg:m-0 lg:-translate-x-1/2 lg:-translate-y-1/2 lg:rotate-0"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                >
                  <path
                    d="M1.5 6h8M6.2 2.6 9.8 6l-3.6 3.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            )}
            <article class="flex flex-col rounded-card bg-bg-elev p-6 sm:p-7">
              <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-fg-faint">
                {s.label}
              </span>
              <h3 class="mt-3 text-[19px] font-medium leading-snug tracking-[-0.015em] text-fg">
                {s.title}
              </h3>
              <p class="mb-7 mt-3 text-[14px] leading-[1.6] text-fg-muted">
                {s.body}
              </p>

              <div class={stage}>
                <div aria-hidden="true" class={texture} style={fade} />
                <div class="relative mx-auto w-full max-w-sm">
                  {s.mock === "chat" ? <WhatsAppChat /> : <Preview />}
                </div>
              </div>
            </article>
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* the arrow leans toward the preview it points at */
  @keyframes hop-nudge {
    0%,
    100% {
      transform: translateX(-1px);
    }
    50% {
      transform: translateX(1.5px);
    }
  }
  .hop svg {
    animation: hop-nudge 1.8s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .hop svg {
      animation: none;
    }
  }
</style>
