---
import SectionHead from "@components/SectionHead.astro";
import Thread from "@components/mock/Thread.astro";
import Preview from "@components/mock/Preview.astro";
import Diff from "@components/mock/Diff.astro";
import Checks from "@components/mock/Checks.astro";
---

<section class="border-t border-border-soft py-28 sm:py-36">
  <div class="shell">
    <SectionHead
      index="03"
      label="Two people, one workflow"
      title="It gives the client a way in without taking the keys."
      sub="The person who wants the feature and the person who owns the codebase finally want the same thing from the same tool."
    />

    <div class="mt-16 grid gap-4 lg:grid-cols-2">
      <!-- client -->
      <article
        data-reveal
        class="flex flex-col rounded-xl border border-border-soft bg-bg-elev p-6 sm:p-8"
      >
        <p class="font-mono text-[11px] text-fg-faint">If you're the one asking</p>
        <h3
          class="mt-3 text-balance text-[clamp(1.35rem,2.1vw,1.7rem)] font-medium leading-[1.15] tracking-tight text-fg"
        >
          You don't need to know what a pull request is.
        </h3>

        <div class="mt-8 grid flex-1 content-center gap-4 rounded-lg bg-bg-sunk p-5 sm:grid-cols-2">
          <Thread />
          <div class="flex flex-col justify-center gap-3">
            <Preview />
            <p class="font-mono text-[10.5px] text-fg-faint">
              ↑ what you get back, by morning
            </p>
          </div>
        </div>

        <p class="mt-6 pt-0 text-[14px] leading-[1.6] text-fg-muted">
          Describe it like you'd describe it to a friend. Get a link you can
          click — not a status update.
        </p>
      </article>

      <!-- engineer -->
      <article
        data-reveal
        class="flex flex-col rounded-xl border border-border-soft bg-bg-elev p-6 sm:p-8"
      >
        <p class="font-mono text-[11px] text-fg-faint">
          If you're the one merging
        </p>
        <h3
          class="mt-3 text-balance text-[clamp(1.35rem,2.1vw,1.7rem)] font-medium leading-[1.15] tracking-tight text-fg"
        >
          You keep the veto, the conventions, and the CI.
        </h3>

        <div class="mt-8 grid flex-1 content-center gap-4 rounded-lg bg-bg-sunk p-5 sm:grid-cols-2">
          <Diff />
          <div class="flex flex-col justify-center">
            <Checks />
            <p class="mt-3 font-mono text-[10.5px] text-fg-faint">
              awaiting your approval
            </p>
          </div>
        </div>

        <p class="mt-6 pt-0 text-[14px] leading-[1.6] text-fg-muted">
          One synthesized diff, never four competing PRs. Nothing reaches main
          without you.
        </p>
      </article>
    </div>
  </div>
</section>
