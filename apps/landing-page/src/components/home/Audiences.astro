---
import SectionHead from "@components/SectionHead.astro";
import WhatsAppChat from "@components/mock/WhatsAppChat.astro";
import Preview from "@components/mock/Preview.astro";
import PullRequest from "@components/mock/PullRequest.astro";
---

<section class=" py-28">
  <div class="shell">
    <SectionHead

      title="It gives the client a way in"
      accent="without taking the keys."
    />

    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      <article
        data-reveal
        class="flex flex-col rounded-xl border border-border-soft bg-bg-elev p-6 sm:p-8"
      >
        <h3
          class=" text-balance text-[clamp(1.35rem,2.1vw,1.6rem)] font-medium leading-[1.15] tracking-tight text-fg"
        >
          You don't need to know what a pull request is.
        </h3>

        <div
          class="relative mt-4 grid flex-1 content-center gap-2 sm:grid-cols-2"
        >
          <WhatsAppChat />
          <div class="flex flex-col justify-center gap-3">
            <Preview />
          </div>

          <span
            aria-hidden="true"
            class="hop absolute left-1/2 top-1/2 z-10 grid size-7 -translate-x-1/2 -translate-y-1/2 rotate-90 place-items-center rounded-full bg-acc text-bg ring-2 ring-bg-bg sm:rotate-0"
          >
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M1.5 6h8M6.2 2.6 9.8 6l-3.6 3.4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </div>

        <p class="mt-3 pt-0 text-[16px] leading-[1.6] tracking-wide text-fg-muted">
          Describe it like you'd describe it to a friend. Get a link you can
          click.
        </p>
      </article>

      <article
        data-reveal
        class="flex flex-col rounded-xl border border-border-soft bg-bg-elev p-6 sm:p-8"
      >
        <h3
          class="text-balance text-[clamp(1.35rem,2.1vw,1.6rem)] font-medium leading-[1.15] tracking-tight text-fg"
        >
          You keep the veto, the conventions and the CI.
        </h3>

        <div class="mt-4 grid flex-1 content-center ">
          <PullRequest />
        </div>

        <p class="mt-3 pt-0 text-[16px] leading-[1.6] tracking-wide text-fg-muted">
          One diff, never four battling PRs. Nothing reaches prod
          without you.
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  /* the arrow leans toward the preview it points at */
  @keyframes hop-nudge {
    0%,
    100% {
      transform: translateX(-1px);
    }
    50% {
      transform: translateX(1.5px);
    }
  }
  .hop svg {
    animation: hop-nudge 1.8s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .hop svg {
      animation: none;
    }
  }
</style>
