---
import Agnostic from "./Agnostic.astro";
import Context from "./Context.astro";
import DiffStack from "./DiffStack.astro";
import PlanFirst from "./PlanFirst.astro";
import ZeroJunk from "./ZeroJunk.astro";
---

<section id="features" class="relative py-30">
  <div class="container mx-auto">
    <div class="max-w-200">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-acc/20 bg-acc/[0.06] px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.1em] text-acc"
      >
        Why DevAgents
      </span>
      <h2
        class="mt-6 bg-linear-to-b from-fg to-fg/65 bg-clip-text text-4xl font-semibold leading-[1.02] tracking-[-0.03em] text-transparent sm:text-5xl lg:text-6xl"
      >
        Built for senior engineers who hate babysitting agents.
      </h2>
    </div>

    <div
      class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4 lg:grid-rows-[auto_auto_auto]"
    >
      <Agnostic />
      <DiffStack />
      <Context />
      <ZeroJunk />
      <PlanFirst />
    </div>
  </div>
</section>
