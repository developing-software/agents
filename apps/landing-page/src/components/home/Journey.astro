---
import SectionHead from "@components/SectionHead.astro";
import Icon from "@components/Icon.astro";
import WppNote from "@components/mock/WppNote.astro";
import Pipe from "./Pipe.astro";
import Button from "@components/Button2.astro";

const card =
  "w-full overflow-hidden rounded-lg border border-border-soft bg-bg-elev";
const bar =
  "border-b border-border-soft bg-bg-sunk px-2.5 py-1.5 font-mono text-[9.5px] uppercase tracking-[0.14em] text-fg-faint";
const caption =
  "absolute top-full mt-5 whitespace-nowrap font-mono text-[9.5px] font-medium uppercase tracking-[0.16em] text-fg-faint";

/* the agent column is a fixed stack, so the fan and the merge can be drawn
   against known row centres without scaling the SVG */
const ROW = 60;
const FAN = 64;
const agents = [
  { name: "claude-fable-5-1", logo: "/ai/claude.svg", ci: true },
  { name: "gpt-6-astra", logo: "/ai/openai.svg", ci: true },
  { name: "gemini-3-8", logo: "/ai/gemini.svg", ci: true },
  { name: "grok-4-6", logo: "/ai/grok.svg", ci: false },
];
const H = agents.length * ROW;
const mid = H / 2;
const ys = agents.map((_, i) => i * ROW + ROW / 2);

const fan = ys.map((y) => ({
  d: `M0 ${mid} H6 C34 ${mid} 30 ${y} ${FAN} ${y}`,
}));
/* whatever fails CI never reaches the judge */
const merge = agents.map((a, i) => ({
  d: `M0 ${ys[i]} C34 ${ys[i]} 30 ${mid} ${FAN} ${mid}`,
  off: !a.ci,
}));
const straight = [{ d: "M0 4 H32" }];

/* read off the run drawn above: asked 23:02, preview 23:23, grok failed CI */
const stats = [
  { value: "21 min", label: "from message to preview" },
  { value: "4", label: "models attempted in parallel" },
  { value: "3 of 4", label: "attempts passed your CI" },
  { value: "1", label: "pull request to review" },
];

const plan = [
  "Add the PDF endpoint",
  "Wire up the button",
  "Cover the empty state",
];
---

<section
  id="journey"
  class="section scroll-mt-24"
>
  <div class="shell">
    <SectionHead
      title="How it"
      accent="works?"
      sub="Many models build the same plan, CI drops what breaks, a judge keeps the best of the rest, and the preview goes back to the thread it started in."
    />

    <div
      data-reveal
      class="relative mt-head overflow-hidden rounded-frame border border-border-soft bg-bg-sunk p-3 sm:p-4"
    >
      <div
        aria-hidden="true"
        class="dotgrid pointer-events-none absolute inset-0 opacity-70"
        style="mask-image:radial-gradient(85% 85% at 50% 40%,#000,transparent 90%);-webkit-mask-image:radial-gradient(85% 85% at 50% 40%,#000,transparent 90%)"
      >
      </div>

      <div
        class="relative overflow-hidden rounded-card border border-border-soft bg-bg-elev"
      >
        <div
          class="flex items-center justify-between gap-4 border-b border-border-soft px-5 py-3 sm:px-6"
        >
          <span class="flex items-center gap-2.5">
            <span class="relative grid size-2 place-items-center">
              <span
                class="absolute size-2 rounded-full bg-acc/40 motion-safe:animate-ping"
              ></span>
              <span class="relative size-2 rounded-full bg-acc"></span>
            </span>
            <span
              class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-fg-muted"
              >Run 4821</span
            >
            <span class="hidden text-[12.5px] text-fg sm:inline"
              >Invoice PDF download</span
            >
          </span>
          <span class="font-mono text-[10.5px] tabular-nums text-fg-faint"
            >23:02 → 23:23</span
          >
        </div>

        <div data-journey class="scrollbar-thin overflow-x-auto bg-bg-sunk">
      <div class="flex w-295 items-center px-4 pb-20 pt-16 font-ui">
        <div
          class="relative flex w-40 shrink-0 flex-col justify-center self-stretch"
        >
          <WppNote text="Can you add a download button to the invoices?" />
          <span class:list={[caption, "inset-x-0 text-center"]}>01 · Ask</span>
        </div>

        <Pipe paths={straight} width={32} height={8} />

        <div
          class="relative flex w-44 shrink-0 flex-col justify-center self-stretch"
        >
          <div class={card}>
            <div class:list={[bar, "flex items-center gap-1.5"]}>
              <span>Generated Plan</span>
            </div>
            <div class="px-3 py-2">
              {
                plan.map((line) => (
                  <p class="truncate py-1 font-mono text-[10.5px] text-fg-muted">
                    {line}
                  </p>
                ))
              }
            </div>
          </div>
          <span class:list={[caption, "inset-x-0 text-center"]}>02 · Plan</span>
        </div>

        <Pipe paths={fan} width={FAN} height={H} delay={500} stagger={80} />

        <div
          class="relative flex w-44 shrink-0 flex-col justify-center self-stretch"
        >
          <div class="flex flex-col" style={`height:${H}px`}>
            {
              agents.map((a) => (
                <div class="flex items-center" style={`height:${ROW}px`}>
                  <div
                    class:list={[
                      "flex h-11 w-full items-center gap-2.5 rounded-full border bg-bg-elev pl-1.5 pr-3",
                      a.ci
                        ? "border-border-soft"
                        : "border-dashed border-border-strong opacity-65",
                    ]}
                  >
                    <span class="grid size-8 shrink-0 place-items-center rounded-full bg-bg-sunk">
                      <img
                        src={a.logo}
                        alt=""
                        width="17"
                        height="17"
                        loading="lazy"
                        class="size-4.25"
                      />
                    </span>
                    <span class="min-w-0 flex-1 truncate font-mono text-[11.5px] text-fg">
                      {a.name}
                    </span>
                    <span
                      class:list={[
                        "inline-flex shrink-0 items-center gap-1 font-mono text-[9px] uppercase tracking-widest",
                        a.ci ? "text-ok" : "text-err",
                      ]}
                    >
                      CI
                      <svg
                        viewBox="0 0 12 12"
                        class="size-2.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        {a.ci ? (
                          <path d="m2.4 6.3 2.4 2.4 4.8-5.1" />
                        ) : (
                          <path d="M3.2 3.2 8.8 8.8M8.8 3.2 3.2 8.8" />
                        )}
                      </svg>
                    </span>
                  </div>
                </div>
              ))
            }
          </div>
          <span class:list={[caption, "inset-x-0 text-center"]}>03 · Build</span
          >
        </div>

        <Pipe paths={merge} width={FAN} height={H} delay={1300} stagger={50} />

        <div
          class="relative flex w-14 shrink-0 flex-col items-center justify-center self-stretch"
        >
          <div class="relative">
            <span
              class="absolute bottom-full left-1/2 mb-2 flex -translate-x-1/2 flex-col items-center"
            >
              <span
                class="whitespace-nowrap font-mono text-[9.5px] font-medium uppercase tracking-[0.16em] text-acc"
                >AI judge</span
              >
              <span
                aria-hidden="true"
                class="mt-1 h-10 border-l border-dotted border-acc"></span>
            </span>

            <span
              class="grid size-14 place-items-center rounded-full border border-acc bg-bg-elev text-acc"
            >
              <Icon name="scale" class="size-8" stroke={1.6} />
            </span>
          </div>
        </div>

        <Pipe paths={straight} width={32} height={8} delay={2000} />

        <div
          class="relative flex min-w-0 flex-1 flex-col justify-center self-stretch"
        >
          <WppNote
            tone="out"
            text="Done, preview is up 👍"
            link="preview-4821.devagents.app"
            time="23:23"
          />
          <span class:list={[caption, "inset-x-0 text-center"]}>04 · Preview</span>
        </div>

        <Pipe paths={straight} width={32} height={8} delay={2400} />

        <div
          class="relative flex w-42 shrink-0 flex-col justify-center self-stretch"
        >
          <div class={card}>
            <div class:list={[bar, "flex items-center gap-1.5"]}>
              <!-- <Icon name="pr" class="size-3 text-acc" stroke={1.8} /> -->
              <span>Pull request</span>
              <span class="ml-auto normal-case tracking-normal">#128</span>
            </div>

            <div class="px-3 py-3">
              <p class="truncate text-[12px] font-medium text-fg">
                Invoice PDF download
              </p>

              <div class="mt-3 grid grid-cols-2 gap-1.5">
                <Button size="xs"> Reject </Button>
                <Button size="xs" variant="primary">
                  <Icon name="check" class="size-2.5" stroke={2.6} />
                  Approve
                </Button>
              </div>
            </div>
          </div>
          <span class:list={[caption, "inset-x-0 text-center"]}>05 · Approve</span>
        </div>
      </div>
        </div>
      </div>

      <dl class="relative mt-3 grid grid-cols-2 gap-3 lg:grid-cols-4">
        {
          stats.map((s) => (
            <div class="rounded-card bg-bg-elev/70 px-5 py-4 sm:px-6">
              <dd class="text-[clamp(1.5rem,2.4vw,1.9rem)] font-medium leading-none tracking-[-0.03em] tabular-nums text-fg">
                {s.value}
              </dd>
              <dt class="mt-2 text-[12.5px] leading-snug text-fg-muted">
                {s.label}
              </dt>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  const DESIGN = 1180;
  const MIN = 0.62;

  const fit = () => {
    document.querySelectorAll<HTMLElement>("[data-journey]").forEach((w) => {
      const track = w.firstElementChild as HTMLElement;
      const s = Math.min(1, Math.max(MIN, w.clientWidth / DESIGN));
      track.style.zoom = String(s);
    });
  };

  fit();
  window.addEventListener("resize", fit);
</script>
