---
const id = `wire-${crypto.randomUUID().slice(0, 8)}`;
---

<div class="wire-slot">
  <svg
    aria-hidden="true"
    class="wire"
    width="12"
    height="52"
    viewBox="0 0 12 52"
    fill="none"
  >
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="stop-tail"></stop>
        <stop offset="0.55" class="stop-mid"></stop>
        <stop offset="1" class="stop-head"></stop>
      </linearGradient>
    </defs>

    <line class="rail" x1="6" y1="0" x2="6" y2="52"></line>

    <g class="pulse">
      <!-- <rect
        x="3"
        y="0"
        width="6"
        height="22"
        rx="3"
        fill={`url(#${id})`}
        opacity="0.28"></rect> -->
      <rect x="4" y="0" width="4" height="22" rx="2" fill={`url(#${id})`}
      ></rect>
    </g>
  </svg>

  <span class="pill">
    <slot />
  </span>
</div>

<style>
  .wire-slot {
    position: relative;
    display: flex;
    height: 3.25rem;
    width: 100%;
    align-items: center;
    justify-content: center;
  }

  .wire {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    overflow: hidden;
  }

  .rail {
    stroke: var(--color-border-strong);
    stroke-width: 4;
  }

  .stop-tail {
    stop-color: var(--color-acc);
    stop-opacity: 0;
  }

  .stop-mid {
    stop-color: var(--color-acc);
  }

  .stop-head {
    stop-color: var(--color-ok);
  }

  .pulse {
    animation: wire-pulse 1.3s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes wire-pulse {
    from {
      transform: translateY(-22px);
    }
    to {
      transform: translateY(52px);
    }
  }

  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: var(--color-acc-wash);
    padding: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-acc);
    white-space: nowrap;
    /* border: 1px solid var(--color-acc); */
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
      transform: translateY(15px);
    }
  }
</style>
