---
import Button from "@components/Button2.astro";
---

<section class="relative py-30">
  <div class="container mx-auto">
    <div
      class="relative overflow-hidden rounded-md border border-border-strong bg-bg-card px-10 py-20 text-center"
    >
      <div
        class="pointer-events-none absolute inset-0  opacity-90"
      >
      </div>
      <div
        class="pointer-events-none absolute left-1/2 -top-1/2 h-full w-[120%] -translate-x-1/2 opacity-55"
      >
      </div>

      <div class="relative">
        <h2
          class="mx-auto max-w-190 text-4xl font-normal leading-[1.05] tracking-[-0.03em] sm:text-5xl lg:text-6xl"
        >
          <span
            class="bg-linear-to-b text-fg bg-clip-text"
          >
            Stop writing boilerplate.<br />
          </span>
          <span
            class="bg-linear-to-b bg-clip-text font-semibold text-acc"
          >
            Start reviewing perfection.
          </span>
        </h2>
        <p
          class="mx-auto mt-5 max-w-130 text-[17px] leading-[1.55] text-fg-muted"
        >
          Two-minute setup with GitHub, GitLab, or self-hosted. Free forever for
          open source.
        </p>
        <div class="mt-8 inline-flex gap-3.5">
          <Button text="Get Started" variant="primary" size="lg" href="#" />
          <Button text="Book a demo" size="lg" href="#" />
        </div>
      </div>
    </div>
  </div>
</section>
