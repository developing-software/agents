---
/**
 * Large thin-stroke illustrations used in the feature grids.
 * Drawn on a 96×96 field, stroke scales with `stroke` prop.
 */
interface Props {
  name:
    | "approval"
    | "ci"
    | "branches"
    | "keys"
    | "audit"
    | "sealed"
    | "intake"
    | "preview";
  class?: string;
}

const { name, class: className = "size-24" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 96 96"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "approval" && (
      <>
        <rect x="10" y="10" width="76" height="76" rx="6" stroke-dasharray="5 5" />
        <circle cx="44" cy="40" r="11" />
        <path d="M25 72a19 19 0 0 1 38 0" />
        <circle cx="72" cy="66" r="13" />
        <path d="m66 66 4.5 4.5L79 62" />
      </>
    )
  }

  {
    name === "ci" && (
      <>
        <rect x="8" y="18" width="24" height="24" rx="3" />
        <rect x="36" y="18" width="24" height="24" rx="3" stroke-dasharray="4 4" />
        <rect x="64" y="18" width="24" height="24" rx="3" />
        <rect x="8" y="54" width="24" height="24" rx="3" stroke-dasharray="4 4" />
        <rect x="36" y="54" width="24" height="24" rx="3" />
        <path d="M14 30h4l2.5 4 4-8 2.5 4h5" />
        <path d="M70 30h12" />
        <path d="M14 66h12" />
        <path d="M42 66h4l2.5 4 4-8 2.5 4h5" />
        <circle cx="76" cy="66" r="12" stroke-dasharray="4 4" />
        <path d="m70 66 4.5 4.5L83 62" />
      </>
    )
  }

  {
    name === "branches" && (
      <>
        <circle cx="14" cy="48" r="6" />
        <path d="M20 48h12" />
        <path d="M32 48c10 0 8-22 18-22" />
        <path d="M32 48h18" />
        <path d="M32 48c10 0 8 22 18 22" />
        <rect x="50" y="16" width="34" height="20" rx="4" stroke-dasharray="4 4" />
        <rect x="50" y="38" width="34" height="20" rx="4" stroke-dasharray="4 4" />
        <rect x="50" y="60" width="34" height="20" rx="4" stroke-dasharray="4 4" />
        <path d="M58 26h10" />
        <path d="M58 48h14" />
        <path d="M58 70h8" />
      </>
    )
  }

  {
    name === "keys" && (
      <>
        <circle cx="48" cy="48" r="36" stroke-dasharray="5 6" />
        <circle cx="48" cy="48" r="25" />
        <circle cx="48" cy="42" r="7" />
        <path d="M44 48h8l3 14H41l3-14Z" />
        <path d="M12 48h8" />
        <path d="M76 48h8" />
      </>
    )
  }

  {
    name === "audit" && (
      <>
        <path d="M14 12v72" stroke-dasharray="4 5" />
        <circle cx="14" cy="26" r="3" />
        <circle cx="14" cy="48" r="3" />
        <circle cx="14" cy="70" r="3" />
        <rect x="26" y="18" width="46" height="16" rx="3" />
        <rect x="26" y="40" width="60" height="16" rx="3" stroke-dasharray="4 4" />
        <rect x="26" y="62" width="38" height="16" rx="3" />
        <path d="M78 18v16" />
        <path d="M70 62h8" />
      </>
    )
  }

  {
    name === "sealed" && (
      <>
        <path d="M48 10 78 22v22c0 20-13 31-30 40-17-9-30-20-30-40V22L48 10Z" />
        <ellipse
          cx="48"
          cy="46"
          rx="34"
          ry="14"
          stroke-dasharray="4 5"
          transform="rotate(-18 48 46)"
        />
        <circle cx="48" cy="46" r="11" />
        <path d="m42 52 12-12" />
      </>
    )
  }

  {
    name === "intake" && (
      <>
        <path d="M16 22h44a6 6 0 0 1 6 6v20a6 6 0 0 1-6 6H32l-16 12V22Z" />
        <path d="M28 34h22" />
        <path d="M28 44h14" />
        <rect
          x="52"
          y="52"
          width="34"
          height="30"
          rx="5"
          stroke-dasharray="4 4"
        />
        <path d="m60 68 4.5 4.5L76 62" />
      </>
    )
  }

  {
    name === "preview" && (
      <>
        <rect x="8" y="18" width="80" height="56" rx="6" />
        <path d="M8 32h80" />
        <circle cx="18" cy="25" r="2" />
        <circle cx="26" cy="25" r="2" />
        <circle cx="34" cy="25" r="2" />
        <rect x="20" y="42" width="30" height="22" rx="3" stroke-dasharray="4 4" />
        <path d="M58 46h20" />
        <path d="M58 54h14" />
        <path d="M58 62h20" />
        <path d="M40 82h16" />
      </>
    )
  }
</svg>
