---
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DevAgents — ship features while your team sleeps",
  description = "A WhatsApp message or a GitHub issue becomes a working pull request. Frontier models implement it in parallel, one agent merges the best of every attempt, and a deployed preview waits for your engineer to approve.",
} = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafbfc" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
  </head>

  <body class="bg-bg antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-100 focus:rounded-sm focus:bg-fg focus:px-4 focus:py-2 focus:text-sm focus:text-bg"
    >
      Skip to content
    </a>

    <Navbar />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      const reveal = () => {
        const items =
          document.querySelectorAll<HTMLElement>("[data-reveal]:not(.is-in)");
        if (!items.length) return;

        if (
          window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !("IntersectionObserver" in window)
        ) {
          items.forEach((el) => el.classList.add("is-in"));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.classList.add("is-in");
              io.unobserve(el);
            });
          },
          { rootMargin: "0px 0px -60px 0px", threshold: 0.05 },
        );

        items.forEach((el, i) => {
          // stagger siblings that share a parent unless an explicit delay is set
          if (!el.style.getPropertyValue("--d")) {
            const siblings = Array.from(
              el.parentElement?.querySelectorAll(":scope > [data-reveal]") ?? [],
            );
            const index = siblings.indexOf(el);
            if (index > 0) el.style.setProperty("--d", `${index * 70}ms`);
          }
          io.observe(el);
          void i;
        });
      };

      reveal();
      document.addEventListener("astro:page-load", reveal);
    </script>
  </body>
</html>
