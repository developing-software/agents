{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/build/**", "infra/**"],
  "overrides": [
    {
      "files": ["*.svelte"],
      "options": {
        "svelte": true,
        "useTabs": true,
        "singleQuote": true,
        "trailingComma": "none",
        "printWidth": 100
      }
    }
  ]
}
