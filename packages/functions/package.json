{
  "name": "@agents/functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "module": "src/api/index.ts",
  "exports": {
    ".": "./src/api/index.ts",
    "./api": "./src/api/index.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/*": "./src/auth/*.ts",
    "./health": "./src/health.ts",
    "./*/target/bun": "./src/*/target/bun.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/api/target/bun.ts",
    "dev:auth": "bun run --hot src/auth/target/bun.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "gen:spec": "bun run scripts/gen-spec.ts"
  },
  "dependencies": {
    "@agents/core": "workspace:*",
    "@openauthjs/openauth": "^0.4.3",
    "hono": "catalog:",
    "hono-openapi": "^1.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
