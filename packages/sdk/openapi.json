                    "type": "string"
                  },
                  "redirectURI": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "redirectURI"
                ],
                "description": "Basic app information.",
                "example": {
                  "name": "Example App",
                  "redirectURI": "https://example.com/callback"
                }
              }
            }
          }
        }
      }
    },
