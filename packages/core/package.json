{
  "name": "@agents/core",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "module": "index.ts",
  "exports": {
    "./*": [
      "./src/*/index.ts",
      "./src/*.ts"
    ],
    "./context": "./src/context.ts",
    "./identifier": "./src/identifier.ts",
    "./actor": "./src/actor.ts",
    "./error": "./src/error.ts",
    "./examples": "./src/examples.ts",
    "./util/*": "./src/util/*.ts",
    "./api/*": "./src/api/*.ts",
    "./agent/*": "./src/agent/*.ts",
    "./email/*": "./src/email/*.ts",
    "./git": "./src/git/index.ts",
    "./git/*": "./src/git/*.ts",
    "./git/installation": "./src/git/installation/index.ts",
    "./git/provider/github": "./src/git/provider/github/index.ts",
    "./git/provider/github/client": "./src/git/provider/github/client.ts",
    "./git/provider/github/webhook": "./src/git/provider/github/webhook.ts",
    "./git/provider/forjero": "./src/git/provider/forjero/index.ts",
    "./git/provider/forjero/client": "./src/git/provider/forjero/client.ts",
    "./git/provider/forjero/webhook": "./src/git/provider/forjero/webhook.ts",
    "./git/branch-artifact": "./src/git/branch-artifact/index.ts",
    "./events/agent-metrics": "./src/events/agent-metrics.ts",
    "./events/tag": "./src/events/tag/index.ts",
    "./events/agent/*": "./src/events/agent/*.ts",
    "./events/plan/*": "./src/events/plan/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@octokit/app": "^16.1.2",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "drizzle-orm": "catalog:",
    "forjero-sdk": "workspace:*",
    "postgres": "^3.4.8",
    "resend": "^6.9.3",
    "ulid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
