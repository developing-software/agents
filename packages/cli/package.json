{
  "name": "cli",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "dev-agents": "src/cli.ts"
  },
  "files": [
    "src/cli.ts",
    "src/lib/**/*.ts"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --compile --outfile dist/dev-agents",
    "build:all": "npm run build:macos && npm run build:linux && npm run build:windows",
    "build:macos": "bun build ./src/cli.ts --compile --target=bun-darwin-arm64 --outfile dist/dev-agents-macos",
    "build:linux": "bun build ./src/cli.ts --compile --target=bun-linux-x64 --outfile dist/dev-agents-linux",
    "build:windows": "bun build ./src/cli.ts --compile --target=bun-windows-x64 --outfile dist/dev-agents.exe"
  },
  "dependencies": {
    "@agents/core": "workspace:*",
    "@agents/functions": "workspace:*",
    "@agents/sdk": "workspace:*",
    "@openauthjs/openauth": "^0.4.3",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
