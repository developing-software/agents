{
  "name": "cli",
  "private": true,
  "bin": {
    "dev-agents": "src/cli.ts"
  },
  "files": [
    "src/cli.ts",
    "src/lib/**/*.ts"
  ],
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build": "bun build.ts bun dist/dev-agents",
    "build:macos-arm": "bun build.ts bun-darwin-arm64 dist/dev-agents-macos-arm",
    "build:macos-x64": "bun build.ts bun-darwin-x64 dist/dev-agents-macos-x64",
    "build:linux": "bun build.ts bun-linux-x64 dist/dev-agents-linux",
    "build:linux-arm": "bun build.ts bun-linux-arm64 dist/dev-agents-linux-arm",
    "build:windows": "bun build.ts bun-windows-x64 dist/dev-agents-windows.exe",
    "build:all": "bun run build:macos-arm && bun run build:macos-x64 && bun run build:linux && bun run build:linux-arm && bun run build:windows"
  },
  "dependencies": {
    "@agents/core": "workspace:*",
    "@agents/functions": "workspace:*",
    "@agents/sdk": "workspace:*",
    "@openauthjs/openauth": "^0.4.3",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
