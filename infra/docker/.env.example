# Copy to infra/docker/.env before running `docker compose up`.

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

# --- Database connection (shared by migrate, api, auth, console) ---
# Host `postgres` is the compose service DNS name. Point this at an external
# managed Postgres instead to skip the bundled db.
DATABASE_URL=postgresql://postgres:password@postgres:5432/postgres

# --- SvelteKit adapter-node ---
# Required for correct form-action and cookie handling behind the proxy/port map.
ORIGIN=http://localhost:3000

# --- Auth ---
# The OpenAuth issuer. `auth` is the compose service DNS name.
AUTH_URL=http://auth:3002
# Signs console session cookies — set to a long random string.
SESSION_SECRET=change-me
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- App ---
NODE_ENV=production
# LiteLLM proxy (OpenAI-compatible; serves Claude and OpenAI models)
LLM_BASE_URL=https://llm.developing.company/v1
LLM_API_KEY=
# Login codes go out through Resend when no Cloudflare email binding exists.
RESEND_API_KEY=

# Optional
# DRIZZLE_LOG=false
