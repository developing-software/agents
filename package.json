{
  "name": "umenu",
  "private": true,
  "workspaces": {
    "catalog": {
      "@types/bun": "1.3.11",
      "drizzle-kit": "^1.0.0-beta.19",
      "drizzle-orm": "^1.0.0-beta.19",
      "hono": "^4.11.3",
      "ulid": "^3.0.2",
      "zod": "^4.3.5",
      "sst": "4.7.3",
      "typescript": "^6"
    },
    "catalogs": {
      "action": {
        "@actions/core": "^1.10.1",
        "@actions/exec": "^1.1.1",
        "@types/node": "^22.0.0"
      },
      "build": {},
      "frontend": {
        "@tailwindcss/vite": "^4.1.18",
        "daisyui": "^5.0.0",
        "tailwindcss": "^4.1.18"
      },
      "testing": {}
    },
    "packages": [
      "packages/*",
      "packages/sdk/ts",
      "apps/*",
      "actions/*",
      "actions/*/*",
      "scripts"
    ]
  },
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules **/node_modules",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "fallow": "fallow health --hotspots --top 3 && fallow dead-code && fallow dupes",
    "fallow:health": "fallow health --hotspots --top 3",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:json": "fallow health --hotspots --top 3 --format json --quiet && fallow dead-code --format json --quiet && fallow dupes --format json --quiet"
  },
  "dependencies": {
    "sst": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260317.1",
    "@types/bun": "catalog:",
    "fallow": "^2.38.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
