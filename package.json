{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "agents",
  "private": true,
  "workspaces": {
    "catalog": {
      "@cloudflare/workers-types": "^4.20260424.1",
      "@types/bun": "1.3.13",
      "drizzle-kit": "^1.0.0-beta.19",
      "drizzle-orm": "^1.0.0-beta.19",
      "hono": "^4.13.8",
      "ulid": "^3.0.2",
      "zod": "^4.3.5",
      "sst": "^4.17.1",
      "typescript": "^6"
    },
    "catalogs": {
      "action": {
        "@actions/core": "^1.10.1",
        "@actions/exec": "^1.1.1",
        "@types/node": "^22.0.0"
      },
      "build": {},
      "frontend": {
        "@sveltejs/adapter-cloudflare": "^7.2.6",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/adapter-node": "^5.5.4",
        "@sveltejs/kit": "^2.50.2",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/vite": "^4.1.18",
        "runed": "^0.37.1",
        "daisyui": "^5.0.0",
        "svelte": "^5.51.0",
        "svelte-check": "^4.4.2",
        "tailwindcss": "^4.1.18",
        "vite": "^7.3.1",
        "vite-plugin-devtools-json": "^1.0.0"
      },
      "testing": {
        "@happy-dom/global-registrator": "^20.8.9",
        "@testing-library/svelte": "^5.3.1"
      }
    },
    "packages": [
      "packages/*",
      "packages/sdk/ts",
      "libs/*",
      "apps/*",
      "actions/*",
      "actions/*/*",
      "scripts"
    ]
  },
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules **/node_modules",
    "cli": "bun run apps/cli/src/index.ts",
    "dev": "bun run scripts/dev.ts",
    "seed": "bun run scripts/seed.ts",
    "docker": "docker compose -f infra/docker/compose.yml",
    "docker:up": "test -f infra/docker/.env || cp infra/docker/.env.example infra/docker/.env; docker compose -f infra/docker/compose.yml up --build -d",
    "docker:logs": "docker compose -f infra/docker/compose.yml logs -f",
    "docker:down": "docker compose -f infra/docker/compose.yml down",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "gen": "bun run scripts/gen-sdk.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prototype": "bun run scripts/prototype.ts",
    "test": "bun --filter '*' test",
    "test:ci": "bun --filter '*' test --reporter=junit --reporter-outfile=junit.xml --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "typecheck": "bun --filter '*' typecheck",
    "fallow": "fallow health --hotspots --top 3 && fallow dead-code && fallow dupes",
    "fallow:health": "fallow health --hotspots --top 3",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:json": "fallow health --hotspots --top 3 --format json --quiet && fallow dead-code --format json --quiet && fallow dupes --format json --quiet"
  },
  "dependencies": {
    "sst": "^4.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@types/bun": "catalog:",
    "fallow": "^3.26.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
